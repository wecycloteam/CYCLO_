// CYCLO — Phase 1 database foundation (auth, roles, profile).
// Provider is PostgreSQL (Supabase-hosted) as of 2026-08-22 — was SQLite for local dev
// before that; DATABASE_URL (see prisma/.env, apps/api/.env, both gitignored) points at
// the real database. Never put a real connection string/password directly in this file —
// it is NOT gitignored and gets committed/pushed as plain text.
//
// NOTE: role/status fields are modeled as String and validated at the application layer
// (see packages/shared-types) rather than native Postgres enums — this was chosen back
// when the schema still needed to stay portable to SQLite; kept for now for zero-downtime
// migration flexibility, not a hard requirement anymore.
// Every entity carries a stable id, createdAt, and updatedAt where mutable, per
// CYCLO_IMPLEMENTATION_PLAN.md section 6/36.

generator client {
  provider      = "prisma-client-js"
  // "native" keeps local dev (Windows/Mac) working; "rhel-openssl-3.0.x" is the engine
  // Netlify Functions need at runtime (Amazon Linux 2023, the OS behind Netlify's Node 20
  // Functions) — without it Prisma falls back to a binary that won't load there.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Allowed values (enforced in application code, not the DB):
// User.role        -> household | business | collector | recycler | authority | admin
// Organization.type -> business | recycler | authority
// VerificationStatus -> unverified | pending | verified | rejected | suspended
// CollectorAvailability -> online | offline
// WasteMaterial.category -> plastic | paper | cardboard | textile | glass | metal | e_waste | organic | other
// WasteListing.status -> see packages/shared-types/src/marketplace.ts LISTING_STATUSES/LISTING_TRANSITIONS
// WasteListing.pickupOption -> seller_dropoff | collection_required | flexible
// PickupRequest.status -> see packages/shared-types/src/collection.ts PICKUP_STATUSES/PICKUP_TRANSITIONS
// Transaction.paymentStatus -> see packages/shared-types/src/collection.ts PAYMENT_STATUSES
// WasteEvent.eventType -> see packages/shared-types/src/collection.ts WASTE_EVENT_TYPES
// WasteListing.moderationStatus -> PENDING | APPROVED | REJECTED (see packages/shared-types/src/admin.ts)
// User.verificationStatus -> general account-level trust badge (unverified|pending|verified|rejected|suspended),
//   distinct from CollectorProfile.verificationStatus (collector competency) and
//   Organization.verificationStatus (business legitimacy) — every user gets this one.
// AiScan.category -> see packages/shared-types/src/marketplace.ts WASTE_CATEGORIES
// WasteListing.quantityUnit -> see packages/shared-types/src/marketplace.ts QUANTITY_UNITS
// WastePrice.category -> see packages/shared-types/src/marketplace.ts WASTE_CATEGORIES

model User {
  id                 String   @id @default(uuid())
  // Chosen at signup, the real identity for phone+password login (AuthService.login) —
  // phone is kept only as contact info for pickup/marketplace, not for logging in.
  // Optional because a Google-only sign-up never sets one.
  username           String?  @unique
  // Optional because a Google-only sign-up never provides one — see AuthService.loginWithGoogle.
  phone              String?  @unique
  email              String?  @unique
  // Set only for accounts created via Google — the real link back to that Google account,
  // used instead of a phone (see AuthService.loginWithGoogle). Postgres allows multiple
  // NULLs in a unique column, so phone-only and email/password accounts are unaffected.
  googleId           String?  @unique
  passwordHash       String?
  name               String
  // Data-URL (base64, resized client-side — same pattern as WasteListing.photos)
  // or an external image URL. No storage abstraction exists yet, so this is the
  // profile-photo equivalent of that same shortcut, not a separate one.
  avatarUrl          String?
  role               String
  verificationStatus String   @default("unverified")
  locale             String   @default("en")
  country            String   @default("TZ")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organizationMemberships OrganizationMember[]
  ownedOrganizations      Organization[]       @relation("OrganizationOwner")
  collectorProfile        CollectorProfile?
  locations               Location[]
  refreshTokens           RefreshToken[]
  wasteListings           WasteListing[]
  pickupRequestsMade      PickupRequest[]      @relation("PickupProducer")
  pickupRequestsAssigned  PickupRequest[]      @relation("PickupCollector")
  transactionsAsSeller    Transaction[]        @relation("TransactionSeller")
  transactionsAsCollector Transaction[]        @relation("TransactionCollector")
  wasteEvents             WasteEvent[]
  aiScans                 AiScan[]
  reviewsGiven            Review[]             @relation("ReviewAuthor")
  reviewsReceived         Review[]             @relation("ReviewSubject")

  @@index([role])
  @@index([verificationStatus])
}

model OtpChallenge {
  id           String    @id @default(uuid())
  phone        String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([phone])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id                 String   @id @default(uuid())
  type               String
  name               String
  verificationStatus String   @default("unverified")
  ownerUserId        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner     User                 @relation("OrganizationOwner", fields: [ownerUserId], references: [id])
  members   OrganizationMember[]
  locations Location[]

  @@index([type])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Location {
  id             String   @id @default(uuid())
  ownerType      String
  userId         String?
  organizationId String?
  label          String
  addressLine    String?
  region         String?
  country        String   @default("TZ")
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wasteListings  WasteListing[]
  pickupRequests PickupRequest[]

  @@index([userId])
  @@index([organizationId])
}

// Canonical, extensible taxonomy (§11) — not hardcoded into application logic.
// Seeded by prisma/seed.ts; extended here (and re-seeded) rather than in code.
model WasteMaterial {
  id         String   @id @default(uuid())
  category   String
  subtype    String
  label      String
  recyclable Boolean  @default(true)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wasteListings  WasteListing[]
  pickupRequests PickupRequest[]
  transactions   Transaction[]
  aiScans        AiScan[]

  @@unique([category, subtype])
  @@index([category])
}

// §14/§15 — a producer's listing of recyclable material. Status is an explicit state
// machine (see packages/shared-types marketplace.ts), never a boolean, enforced in
// MarketplaceService before any write.
model WasteListing {
  id                String    @id @default(uuid())
  sellerId          String
  materialId        String
  locationId        String
  estimatedWeightKg Float
  verifiedWeightKg  Float?
  condition         String?
  grade             String?
  purity            Float?
  photos            String? // JSON-encoded array of storage refs/URLs
  askingPrice       Float?
  // Display-only unit label chosen by the seller (kg | tonnes | pieces | litres, see
  // shared-types QUANTITY_UNITS) — estimatedWeightKg/verifiedWeightKg stay the single
  // numeric quantity the rest of the system (pricing, transactions) operates on.
  quantityUnit      String    @default("kg")
  pickupOption      String
  description       String?
  status            String    @default("DRAFT")
  // Orthogonal to `status` on purpose — admin moderation gate, not part of the
  // operational state machine, so it never touches the already-tested transition table.
  // A listing only needs to reach ACTIVE (the seller's "publish"/submit action) to enter
  // the admin queue; browseActive() requires both status=ACTIVE and moderationStatus=APPROVED.
  moderationStatus  String    @default("PENDING")
  moderationReason  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime?

  seller         User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  material       WasteMaterial   @relation(fields: [materialId], references: [id])
  location       Location        @relation(fields: [locationId], references: [id])
  pickupRequests PickupRequest[]

  @@index([sellerId])
  @@index([materialId])
  @@index([status])
  @@index([moderationStatus])
}

// §18/§19/§20 — a producer's request to have material collected. Optionally tied to a
// WasteListing (the §75 vertical slice's path: list -> request pickup -> collector
// completes -> transaction); listingId is nullable because §18 also describes standalone
// "just pick this up" requests with no marketplace listing behind them.
model PickupRequest {
  id                     String    @id @default(uuid())
  producerId             String
  locationId             String
  materialId             String
  listingId              String?
  estimatedWeightKg      Float
  verifiedWeightKg       Float?
  weightRecordedByUserId String?
  weightRecordedAt       DateTime?
  weightMethod           String?
  preferredTime          DateTime?
  notes                  String?
  status                 String    @default("CREATED")
  assignedCollectorId    String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  producer    User          @relation("PickupProducer", fields: [producerId], references: [id], onDelete: Cascade)
  collector   User?         @relation("PickupCollector", fields: [assignedCollectorId], references: [id])
  location    Location      @relation(fields: [locationId], references: [id])
  material    WasteMaterial @relation(fields: [materialId], references: [id])
  listing     WasteListing? @relation(fields: [listingId], references: [id])
  wasteEvents WasteEvent[]
  transaction Transaction?

  @@index([producerId])
  @@index([assignedCollectorId])
  @@index([status])
}

// §25 — immutable once paymentStatus reaches a terminal state (enforced in
// CollectionService, not the DB — corrections happen via new linked records, never
// mutation). One Transaction per completed PickupRequest for this slice; buyerId is
// nullable because the recycler/buyer side (§16, Phase 7) doesn't exist yet — a real
// buyer populates it once BuyRequest/Offer are built without changing this shape.
model Transaction {
  id               String   @id @default(uuid())
  reference        String   @unique
  pickupRequestId  String   @unique
  sellerId         String
  collectorId      String?
  buyerId          String?
  materialId       String
  verifiedWeightKg Float
  agreedPrice      Float?
  platformFee      Float    @default(0)
  grossAmount      Float?
  netAmount        Float?
  paymentStatus    String   @default("PENDING")
  createdAt        DateTime @default(now())

  pickupRequest PickupRequest @relation(fields: [pickupRequestId], references: [id])
  seller        User          @relation("TransactionSeller", fields: [sellerId], references: [id])
  collector     User?         @relation("TransactionCollector", fields: [collectorId], references: [id])
  material      WasteMaterial @relation(fields: [materialId], references: [id])
  wasteEvents   WasteEvent[]
  review        Review?

  @@index([sellerId])
}

// A buyer/collector rates the seller once their Transaction exists (§25) — one review per
// transaction, enforced by the unique transactionId, so a rating always traces back to a
// real completed exchange (never fabricated, never editable into a second vote). Ratings
// are shown aggregated on the SELLER (their listings display their overall average),
// not per-listing, since a listing itself has no buyer until it's already sold.
model Review {
  id            String   @id @default(uuid())
  transactionId String   @unique
  reviewerId    String
  revieweeId    String
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    User        @relation("ReviewSubject", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@index([revieweeId])
}

// §23/§24 — the append-only traceability chain. Every PickupRequest status transition
// (and the Transaction it produces) writes one row here; nothing is ever updated or
// deleted, so this table alone reconstructs a waste item's full journey.
model WasteEvent {
  id              String   @id @default(uuid())
  pickupRequestId String?
  transactionId   String?
  eventType       String
  actorId         String?
  notes           String?
  previousState   String?
  newState        String?
  createdAt       DateTime @default(now())

  pickupRequest PickupRequest? @relation(fields: [pickupRequestId], references: [id])
  transaction   Transaction?   @relation(fields: [transactionId], references: [id])
  actor         User?          @relation(fields: [actorId], references: [id])

  @@index([pickupRequestId])
  @@index([transactionId])
}

// §17 — admin-editable reference price per WasteMaterial.category, driving every
// "Estimated Market Value" shown to users. One row per category, not per material/subtype
// (the taxonomy can have many subtypes per category; a per-category price is the level the
// master prompt's "Waste Prices" transparency section operates at).
model WastePrice {
  category   String   @id
  pricePerKg Float
  updatedAt  DateTime @updatedAt
}

model CollectorProfile {
  userId             String   @id
  verificationStatus String   @default("unverified")
  vehicleType        String?
  vehiclePlate       String?
  serviceAreaLabel   String?
  availability       String   @default("offline")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id               String    @id @default(uuid())
  subjectType      String
  subjectId        String
  status           String    @default("pending")
  documents        String? // JSON-encoded array of storage refs
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([subjectType, subjectId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   String? // JSON-encoded
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

// §11-§13, §33 — one row per scan attempt. No image bytes/ref are stored: the storage
// abstraction (§39) doesn't exist yet, so nothing here pretends photos are persisted.
// `mock` is true for every scan right now (see apps/api/src/ai — MockWasteClassifier is
// the only provider bound); a real vision provider flips it to false without changing
// this shape. finalMaterialId/acceptedResult are set once the user proceeds to a listing
// — null until then, since the AI never creates a listing on its own (§12).
model AiScan {
  id              String   @id @default(uuid())
  userId          String
  category        String
  subtype         String?
  label           String
  confidence      Float
  recyclable      Boolean
  mock            Boolean  @default(true)
  finalMaterialId String?
  acceptedResult  Boolean?
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalMaterial WasteMaterial? @relation(fields: [finalMaterialId], references: [id])

  @@index([userId])
}
