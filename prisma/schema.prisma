// CYCLO — Phase 1 database foundation (auth, roles, profile).
// Provider is SQLite for local dev (per CYCLO_IMPLEMENTATION_PLAN.md open decisions);
// swapped to PostgreSQL for staging/production without changing the model shapes below.
//
// NOTE: Prisma's native `enum` type is not supported on the SQLite connector, so
// role/status fields are modeled as String and validated at the application layer
// (see packages/shared-types) — this keeps the schema portable across both providers.
// Every entity carries a stable id, createdAt, and updatedAt where mutable, per
// CYCLO_IMPLEMENTATION_PLAN.md section 6/36.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Allowed values (enforced in application code, not the DB):
// User.role        -> household | business | collector | recycler | authority | admin
// Organization.type -> business | recycler | authority
// VerificationStatus -> unverified | pending | verified | rejected | suspended
// CollectorAvailability -> online | offline
// WasteMaterial.category -> plastic | paper | cardboard | glass | metal | e_waste | organic | other
// WasteListing.status -> see packages/shared-types/src/marketplace.ts LISTING_STATUSES/LISTING_TRANSITIONS
// WasteListing.pickupOption -> seller_dropoff | collection_required | flexible
// PickupRequest.status -> see packages/shared-types/src/collection.ts PICKUP_STATUSES/PICKUP_TRANSITIONS
// Transaction.paymentStatus -> see packages/shared-types/src/collection.ts PAYMENT_STATUSES
// WasteEvent.eventType -> see packages/shared-types/src/collection.ts WASTE_EVENT_TYPES

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  email        String?  @unique
  passwordHash String?
  name         String
  role         String
  locale       String   @default("en")
  country      String   @default("TZ")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationMemberships OrganizationMember[]
  ownedOrganizations      Organization[]        @relation("OrganizationOwner")
  collectorProfile        CollectorProfile?
  locations               Location[]
  refreshTokens           RefreshToken[]
  wasteListings           WasteListing[]
  pickupRequestsMade      PickupRequest[]        @relation("PickupProducer")
  pickupRequestsAssigned  PickupRequest[]        @relation("PickupCollector")
  transactionsAsSeller    Transaction[]          @relation("TransactionSeller")
  transactionsAsCollector Transaction[]          @relation("TransactionCollector")
  wasteEvents             WasteEvent[]

  @@index([role])
}

model OtpChallenge {
  id           String    @id @default(uuid())
  phone        String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([phone])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id                 String   @id @default(uuid())
  type               String
  name               String
  verificationStatus String   @default("unverified")
  ownerUserId        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner      User                 @relation("OrganizationOwner", fields: [ownerUserId], references: [id])
  members    OrganizationMember[]
  locations  Location[]

  @@index([type])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Location {
  id             String   @id @default(uuid())
  ownerType      String
  userId         String?
  organizationId String?
  label          String
  addressLine    String?
  region         String?
  country        String   @default("TZ")
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wasteListings WasteListing[]
  pickupRequests PickupRequest[]

  @@index([userId])
  @@index([organizationId])
}

// Canonical, extensible taxonomy (§11) — not hardcoded into application logic.
// Seeded by prisma/seed.ts; extended here (and re-seeded) rather than in code.
model WasteMaterial {
  id         String   @id @default(uuid())
  category   String
  subtype    String
  label      String
  recyclable Boolean  @default(true)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wasteListings   WasteListing[]
  pickupRequests  PickupRequest[]
  transactions    Transaction[]

  @@unique([category, subtype])
  @@index([category])
}

// §14/§15 — a producer's listing of recyclable material. Status is an explicit state
// machine (see packages/shared-types marketplace.ts), never a boolean, enforced in
// MarketplaceService before any write.
model WasteListing {
  id               String    @id @default(uuid())
  sellerId         String
  materialId       String
  locationId       String
  estimatedWeightKg Float
  verifiedWeightKg  Float?
  condition        String?
  grade            String?
  purity           Float?
  photos           String? // JSON-encoded array of storage refs/URLs
  askingPrice      Float?
  pickupOption     String
  description      String?
  status           String    @default("DRAFT")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expiresAt        DateTime?

  seller         User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  material       WasteMaterial   @relation(fields: [materialId], references: [id])
  location       Location        @relation(fields: [locationId], references: [id])
  pickupRequests PickupRequest[]

  @@index([sellerId])
  @@index([materialId])
  @@index([status])
}

// §18/§19/§20 — a producer's request to have material collected. Optionally tied to a
// WasteListing (the §75 vertical slice's path: list -> request pickup -> collector
// completes -> transaction); listingId is nullable because §18 also describes standalone
// "just pick this up" requests with no marketplace listing behind them.
model PickupRequest {
  id                     String    @id @default(uuid())
  producerId             String
  locationId             String
  materialId             String
  listingId              String?
  estimatedWeightKg      Float
  verifiedWeightKg       Float?
  weightRecordedByUserId String?
  weightRecordedAt       DateTime?
  weightMethod           String?
  preferredTime          DateTime?
  notes                  String?
  status                 String    @default("CREATED")
  assignedCollectorId    String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  producer  User           @relation("PickupProducer", fields: [producerId], references: [id], onDelete: Cascade)
  collector User?          @relation("PickupCollector", fields: [assignedCollectorId], references: [id])
  location  Location       @relation(fields: [locationId], references: [id])
  material  WasteMaterial  @relation(fields: [materialId], references: [id])
  listing   WasteListing?  @relation(fields: [listingId], references: [id])
  wasteEvents WasteEvent[]
  transaction Transaction?

  @@index([producerId])
  @@index([assignedCollectorId])
  @@index([status])
}

// §25 — immutable once paymentStatus reaches a terminal state (enforced in
// CollectionService, not the DB — corrections happen via new linked records, never
// mutation). One Transaction per completed PickupRequest for this slice; buyerId is
// nullable because the recycler/buyer side (§16, Phase 7) doesn't exist yet — a real
// buyer populates it once BuyRequest/Offer are built without changing this shape.
model Transaction {
  id               String   @id @default(uuid())
  reference        String   @unique
  pickupRequestId  String   @unique
  sellerId         String
  collectorId      String?
  buyerId          String?
  materialId       String
  verifiedWeightKg Float
  agreedPrice      Float?
  platformFee      Float    @default(0)
  grossAmount      Float?
  netAmount        Float?
  paymentStatus    String   @default("PENDING")
  createdAt        DateTime @default(now())

  pickupRequest PickupRequest @relation(fields: [pickupRequestId], references: [id])
  seller        User          @relation("TransactionSeller", fields: [sellerId], references: [id])
  collector     User?         @relation("TransactionCollector", fields: [collectorId], references: [id])
  material      WasteMaterial @relation(fields: [materialId], references: [id])
  wasteEvents   WasteEvent[]

  @@index([sellerId])
}

// §23/§24 — the append-only traceability chain. Every PickupRequest status transition
// (and the Transaction it produces) writes one row here; nothing is ever updated or
// deleted, so this table alone reconstructs a waste item's full journey.
model WasteEvent {
  id              String   @id @default(uuid())
  pickupRequestId String?
  transactionId   String?
  eventType       String
  actorId         String?
  notes           String?
  previousState   String?
  newState        String?
  createdAt       DateTime @default(now())

  pickupRequest PickupRequest? @relation(fields: [pickupRequestId], references: [id])
  transaction   Transaction?   @relation(fields: [transactionId], references: [id])
  actor         User?          @relation(fields: [actorId], references: [id])

  @@index([pickupRequestId])
  @@index([transactionId])
}

model CollectorProfile {
  userId             String   @id
  verificationStatus String   @default("unverified")
  vehicleType        String?
  vehiclePlate       String?
  serviceAreaLabel   String?
  availability       String   @default("offline")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id             String    @id @default(uuid())
  subjectType    String
  subjectId      String
  status         String    @default("pending")
  documents      String? // JSON-encoded array of storage refs
  reviewedByUserId String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([subjectType, subjectId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  targetType String
  targetId  String
  metadata  String? // JSON-encoded
  createdAt DateTime @default(now())

  @@index([targetType, targetId])
}
