# Copy to .env for local development. Never commit the real .env.
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-1-your-region.pooler.supabase.com:5432/postgres"
JWT_ACCESS_SECRET="dev-only-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"
WEB_ORIGIN="http://localhost:3001"
PORT=3000
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
